# All paths used by rsx, in one place.
# Sourced by the bash scripts (set -a; source configs/paths.env; set +a) and parsed by rsx.paths.
# Syntax: KEY=${KEY:-default}  ->  a value already exported in the environment wins.
# Only ${VAR} and ${VAR:-default} expansions are supported (no command substitution).

# Code and Python (conda env "python311", already configured on this account)
RSX_ROOT=${RSX_ROOT:-/home/hpc/y106bb/y106bb17/projects/vllm_reports_structuring}
PYTHON=${PYTHON:-/home/hpc/y106bb/y106bb17/conda_environments/python311/bin/python}

# Big files on /hnvme (mounted on GPU nodes). Tight inode quota: only the SIF and model shards go here.
RSX_DATA=${RSX_DATA:-/hnvme/workspace/y106bb17-lmalerba_data}
RSX_MODELS_DIR=${RSX_MODELS_DIR:-${RSX_DATA}/models}
RSX_CONTAINERS_DIR=${RSX_CONTAINERS_DIR:-${RSX_DATA}/containers}
RSX_TIKTOKEN_DIR=${RSX_TIKTOKEN_DIR:-${RSX_MODELS_DIR}/tiktoken}

# vLLM container image (pinned) and its local Apptainer file
RSX_VLLM_IMAGE=${RSX_VLLM_IMAGE:-docker://vllm/vllm-openai:v0.31.0}
RSX_SIF=${RSX_SIF:-${RSX_CONTAINERS_DIR}/vllm-openai_v0.31.0.sif}

# Run outputs (small: one JSONL + exports per run), next to the code in $HOME
RSX_RUNS_DIR=${RSX_RUNS_DIR:-${RSX_ROOT}/runs}

# Login node only: download / build caches (local disk, never $HOME or /hnvme)
RSX_SCRATCH=${RSX_SCRATCH:-/scratch/${USER}/rsx}
RSX_PROXY_SCRIPT=${RSX_PROXY_SCRIPT:-${HOME}/proxy.sh}

# vLLM / Triton / torch.compile caches inside jobs.
# Empty = node-local ${TMPDIR}/rsx_<jobid>, deleted at the end of the job.
# Set e.g. to ${HOME}/.cache/rsx-vllm to keep the compile cache between jobs (faster startup, ~1-3k inodes).
RSX_VLLM_CACHE=${RSX_VLLM_CACHE:-}

# Inode guard for /hnvme used by download_models.sh (abort above this number of files)
RSX_HNVME_MAX_FILES=${RSX_HNVME_MAX_FILES:-55000}
